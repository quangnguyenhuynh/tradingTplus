    "stock_intraday": {
      "contract_version": "1.0.0",
      "fields": {
        "symbol": {
          "description": "Canonical stock ticker",
          "type": "string",
          "unit": "none",
          "required": true,
          "nullable": false
        },
        "time": {
          "description": "Candle market timestamp converted from Vietnam time to UTC",
          "type": "datetime",
          "unit": "UTC ISO-8601",
          "required": true,
          "nullable": false,
          "timezone": "source Asia/Ho_Chi_Minh; output UTC",
          "bar_convention": "SSI v2 candle timestamp"
        },
        "open": {
          "description": "Unadjusted candle open",
          "type": "number",
          "unit": "VND/share",
          "required": false,
          "nullable": true
        },
        "high": {
          "description": "Unadjusted candle high",
          "type": "number",
          "unit": "VND/share",
          "required": false,
          "nullable": true
        },
        "low": {
          "description": "Unadjusted candle low",
          "type": "number",
          "unit": "VND/share",
          "required": false,
          "nullable": true
        },
        "close": {
          "description": "Unadjusted candle close",
          "type": "number",
          "unit": "VND/share",
          "required": false,
          "nullable": true
        },
        "volume": {
          "description": "Per-candle matched volume; not cumulative",
          "type": "number",
          "unit": "shares",
          "required": false,
          "nullable": true,
          "minimum": 0
        },
        "timeframe": {
          "description": "Persisted candle timeframe",
          "type": "string",
          "unit": "none",
          "required": true,
          "nullable": false,
          "allowed": [
            "1m"
          ]
        },
        "value": {
          "description": "Estimated candle value: round(close * volume)",
          "type": "integer",
          "unit": "estimated VND",
          "required": false,
          "nullable": true
        },
        "reference_price": {
          "description": "Optional daily reference-price context",
          "type": "number",
          "unit": "VND/share",
          "required": false,
          "nullable": true
        },
        "ceiling_price": {
          "description": "Optional daily ceiling-price context",
          "type": "number",
          "unit": "VND/share",
          "required": false,
          "nullable": true
        },
        "floor_price": {
          "description": "Optional daily floor-price context",
          "type": "number",
          "unit": "VND/share",
          "required": false,
          "nullable": true
        }
      }
