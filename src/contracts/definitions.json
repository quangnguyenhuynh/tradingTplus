          "description": "Provider foreign net volume",
          "type": "number",
          "unit": "shares",
          "required": false,
          "nullable": true
        },
        "net_foreign_val": {
          "description": "Provider foreign net value",
          "type": "number",
          "unit": "VND",
          "required": false,
          "nullable": true
