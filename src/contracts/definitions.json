{
  "schema_version": "1",
  "datasets": {
    "stock_daily": {
      "contract_version": "2.0.0",
      "fields": {
        "symbol": {
          "description": "Canonical stock ticker",
          "type": "string",
          "unit": "none",
          "required": true,
          "nullable": false
        },
        "trading_date": {
          "description": "Vietnam trading date",
          "type": "date",
          "unit": "YYYY-MM-DD",
          "required": true,
          "nullable": false,
          "timezone": "Asia/Ho_Chi_Minh"
        },
        "price_change": {
          "description": "Unadjusted close price change",
          "type": "number",
          "unit": "VND/share",
          "required": false,
          "nullable": true
        },
        "per_price_change": {
          "description": "Unadjusted close percentage change",
          "type": "number",
          "unit": "percent",
          "required": false,
          "nullable": true
        },
        "ceiling_price": {
          "description": "Unadjusted session ceiling price; SSI v2 zero placeholder is unknown",
          "type": "number",
          "unit": "VND/share",
          "required": false,
          "nullable": true
        },
        "floor_price": {
          "description": "Unadjusted session floor price; SSI v2 zero placeholder is unknown",
          "type": "number",
          "unit": "VND/share",
          "required": false,
          "nullable": true
        },
        "ref_price": {
          "description": "Unadjusted reference price; SSI v2 zero placeholder is unknown",
          "type": "number",
          "unit": "VND/share",
          "required": false,
          "nullable": true
        },
        "open_price": {
          "description": "Unadjusted open price",
          "type": "number",
          "unit": "VND/share",
          "required": false,
          "nullable": true
        },
        "highest_price": {
          "description": "Unadjusted session high",
          "type": "number",
          "unit": "VND/share",
          "required": false,
          "nullable": true
        },
        "lowest_price": {
          "description": "Unadjusted session low",
          "type": "number",
          "unit": "VND/share",
          "required": false,
          "nullable": true
        },
        "close_price": {
          "description": "Unadjusted close price",
          "type": "number",
          "unit": "VND/share",
          "required": false,
          "nullable": true
        },
        "average_price": {
          "description": "Provider session average price",
          "type": "number",
          "unit": "VND/share",
          "required": false,
          "nullable": true
        },
        "close_price_adjusted": {
          "description": "Corporate-action-adjusted close price",
          "type": "number",
          "unit": "VND/share",
          "required": false,
          "nullable": true
        },
        "total_match_vol": {
          "description": "Matched-order volume",
          "type": "number",
          "unit": "shares",
          "required": false,
          "nullable": true,
          "minimum": 0
        },
        "total_match_val": {
          "description": "Provider matched-order value",
          "type": "number",
          "unit": "VND",
          "required": false,
          "nullable": true,
          "minimum": 0
        },
        "total_deal_vol": {
          "description": "Put-through deal volume",
          "type": "number",
          "unit": "shares",
          "required": false,
          "nullable": true,
          "minimum": 0
        },
        "total_deal_val": {
          "description": "Provider put-through deal value",
          "type": "number",
          "unit": "VND",
          "required": false,
          "nullable": true,
          "minimum": 0
        },
        "total_traded_vol": {
          "description": "Provider total traded volume",
          "type": "number",
          "unit": "shares",
          "required": false,
          "nullable": true,
          "minimum": 0
        },
        "total_traded_value": {
          "description": "Provider total traded value",
          "type": "number",
          "unit": "VND",
          "required": false,
          "nullable": true,
          "minimum": 0
        },
        "foreign_buy_vol_total": {
          "description": "Foreign buy volume",
          "type": "number",
          "unit": "shares",
          "required": false,
          "nullable": true,
          "minimum": 0
        },
        "foreign_sell_vol_total": {
          "description": "Foreign sell volume",
          "type": "number",
          "unit": "shares",
          "required": false,
          "nullable": true,
          "minimum": 0
        },
        "foreign_buy_val_total": {
          "description": "Foreign buy value",
          "type": "number",
          "unit": "VND",
          "required": false,
          "nullable": true,
          "minimum": 0
